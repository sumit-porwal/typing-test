.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs & Debug Output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Large Deprecated 3D Model Binaries (>50MB / GitHub 100MB Hard Limit Safeguard)
depricated/3D/*.obj
depricated/3D/*.blend
depricated/3D/*.glb
depricated/3D/*.glb
depricated/3D/*

depricated/screenshots/

